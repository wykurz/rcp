scripts/cargo-host.sh	CARGO_BIN="${CARGO:-cargo}"
scripts/cargo-install-host.sh	exec "${CARGO:-cargo}" install --target "$RUSTC_HOST" "$@"
scripts/check-build-targets.sh	"CARGO=$bin_dir/cargo" \
